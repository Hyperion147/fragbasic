DATABASE_URL=""

# Cloudinary (preferred image storage/CDN). Keep these server-side.
# When set, admin uploads go to Cloudinary; use `npm run images:migrate -- --apply`
# to copy existing Supabase images across.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Supabase Storage (fallback while Cloudinary is not configured)
# The bucket must exist and be PUBLIC so product images render on the public site.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="mousepads"

AUTH_SECRET="" // openssl rand -base64 32

AUTH_URL="" // localhost:3000

ADMIN_EMAIL="" // email for admin profile
ADMIN_PASSWORD_HASH="" // npx tsx -e "import bcrypt from 'bcryptjs'; const h = bcrypt.hashSync('NEW_PASSWORD_HERE', 12); console.log('hash', h); console.log('b64', Buffer.from(h).toString('base64'));"
