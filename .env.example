# Copy this template to .env for local development. Never commit real secrets.
# Vercel: configure these values in the existing project's environment settings.
DATABASE_URL=postgresql://user:password@localhost:5432/fragbasic

# Generate a strong secret, for example with: openssl rand -base64 32
AUTH_SECRET=replace_with_a_random_secret_of_at_least_32_characters
# Local URL below; use https://fragbasic.fun on Vercel, or allow host detection.
AUTH_URL=http://localhost:3000
ADMIN_EMAIL=admin@example.com
# Store the base64 encoding of a full bcrypt hash. Raw bcrypt $ characters are
# expanded by Next's .env parser; use ADMIN_PASSWORD_HASH_B64 to avoid corruption.
ADMIN_PASSWORD_HASH_B64=replace_with_base64_encoded_bcrypt_hash

# Preferred upload provider; public delivery uses the cloud name.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional alternative upload provider.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=mousepads
